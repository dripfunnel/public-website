# Public address of the website (used for canonical links, sitemap, share previews).
NEXT_PUBLIC_SITE_URL=https://www.dripfunnel.com
# "production" = search engines may index the site. Any other value (for example "staging") hides it from search engines.
NEXT_PUBLIC_SITE_ENV=production
# Where the "Sign in" and "Start free" buttons send people (the DripFunnel store portal). Not decided yet.
NEXT_PUBLIC_STORE_URL=
