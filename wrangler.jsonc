{
	// Cloudflare Worker that serves the website (see docs/deployment.md).
	// Cloudflare runs `npm run build`, then `npx wrangler deploy`. Try it locally with `npm run preview:local`.
	// The name must match the Worker project in the Cloudflare dashboard.
	"name": "dripfunnel-pw",
	"compatibility_date": "2025-07-18",
	// Small piece of code for the bare address "/" and /api/* (country redirect, location lookup, contact form).
	"main": "worker/index.js",
	"assets": {
		// `npm run build` writes the finished static site here.
		"directory": "./out",
		"binding": "ASSETS",
		// /in/pricing -> /in/pricing/ (matches trailingSlash in next.config.mjs).
		"html_handling": "force-trailing-slash",
		// Unknown addresses show out/404.html with status 404.
		"not_found_handling": "404-page",
		// Only these addresses run the code; every other page is served straight from ./out.
		"run_worker_first": ["/", "/api/*"]
	}
	// LEAD_WEBHOOK_URL (contact form) is a secret: set it in the dashboard under the Worker's
	// Settings > Variables and Secrets, or locally in .dev.vars. Not here.
}
